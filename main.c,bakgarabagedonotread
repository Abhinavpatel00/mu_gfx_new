/* ============================================================== CRYPT RUN
 *
 * main.c is the shell: it owns the renderer's GameHooks, the camera, the HUD,
 * and the fixed-step accumulator. Everything the game actually simulates lives
 * in src/game/.
 *
 * Frame:
 *   pets_frame    input -> intent, accumulator -> N fixed steps of crypt_sim_step
 *   pets_render   tables -> scene instances, then scene_frame
 */

